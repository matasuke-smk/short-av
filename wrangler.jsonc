{
  // Cloudflare Workers の設定（2026-10-29 Vercel からの移行の準備、11/1 本番をつなぎ替え。OpenNext で組み立てる）
  "$schema": "node_modules/wrangler/config-schema.json",
  // 入口は worker.ts（ページの表示は OpenNext、定期実行は worker.ts の scheduled）
  "main": "worker.ts",
  "name": "short-av",
  // 本番のドメイン（2026-11-01 Vercel からつなぎ替え）。DNS の short-av.com はプロキシあり（オレンジの雲）にしてある。
  // www.short-av.com は当面 Vercel のまま（Vercel が short-av.com へ 308 で転送する。11/7 の Vercel 解約までに Cloudflare の転送に替える）
  "routes": [{ "pattern": "short-av.com/*", "zone_name": "short-av.com" }],
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "short-av"
    }
  ],
  // 作り直しのあるページと unstable_cache の保存先（open-next.config.ts の r2IncrementalCache）
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "short-av-cache"
    }
  ],
  // 定期実行（UTC。vercel.json の crons と同じ。呼ぶ API は worker.ts の CRON_PATHS）。
  // 試しの URL の間は Vercel と2重に動かないよう空にしておく。本番をつなぎ替えて Vercel の crons を止めるときに、次の8つを入れる（2026-10-31 にアニメの "10 22 * * *" を追加）:
  // "30 21 * * *", "40 21 * * *", "*/10 * * * *", "0 1 * * *", "50 21 * * *", "0 22 * * *", "10 22 * * *", "0 1 * * 1"
  "triggers": {
    "crons": []
  },
  // 記録（ログ）を残す。ロボット・/go・定期実行の失敗を Cloudflare の画面（Workers の Observability）で調べるため。Vercel の requests ログの代わり
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // 1回の処理で使える計算時間（Workers Paid のみ。最大5分。作品の取り込み・要約の作成は長い。Vercel の maxDuration は最大300秒）
  "limits": {
    "cpu_ms": 300000
  }
}
